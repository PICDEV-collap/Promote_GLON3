{
  "version": 2,
  "name": "promote-glon-3",
  "cleanUrls": true,
  "outputDirectory": ".",
  "buildCommand": null,
  "rewrites": [
    {
      "source": "/line",
      "destination": "/line.html"
    },
    {
      "source": "/dream",
      "destination": "/dream.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://coupon-powered-loud-relationship.trycloudflare.com/api/:path*"
    },
    {
      "source": "/qrcodes/:path*",
      "destination": "https://coupon-powered-loud-relationship.trycloudflare.com/qrcodes/:path*"
    },
    {
      "source": "/download-qr/:path*",
      "destination": "https://coupon-powered-loud-relationship.trycloudflare.com/download-qr/:path*"
    }
  ]
}
