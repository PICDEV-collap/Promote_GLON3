cd /d "%~dp0"

echo ===================================================================
echo     ⚡ ร้านสลาก N3 ธนกิจนำโชค - อัปเดตโค้ดล่าสุด + รีสตาร์ทบอท
echo ===================================================================
echo.
echo กำลัง Compile โค้ดล่าสุดและรีสตาร์ทบอท โดยคง Cloudflare Tunnel ไว้...
echo.

node scripts\n3-engine.js update

echo.
echo ===================================================================
echo     ✅ อัปเดตและรีสตาร์ทเรียบร้อยแล้ว Webhook URL ไม่เปลี่ยนแปลง
echo ===================================================================
echo.
echo กำลังปิดหน้าต่างนี้ใน 3 วินาที... (หรือกดปุ่มใดๆ เพื่อปิดทันที)
timeout /t 3 >nul 2>&1
