@echo off
title RESTART N3 BOT - รีสตาร์ทบอทสลาก N3 (ไม่เปลี่ยน Webhook URL)
chcp 65001 >nul
cd /d "%~dp0"

echo ===================================================================
echo     🔄 ร้านสลาก N3 ธนกิจนำโชค - รีสตาร์ทบอท (คง Webhook URL เดิม)
echo ===================================================================
echo.
echo กำลังรีสตาร์ท Bot Service โดยคง Cloudflare Tunnel ไว้...
echo.

node scripts\n3-engine.js restart-bot

echo.
echo ===================================================================
echo     ✅ รีสตาร์ทบอทเรียบร้อยแล้ว Webhook URL ไม่เปลี่ยนแปลง
echo ===================================================================
echo.
echo กำลังปิดหน้าต่างนี้ใน 3 วินาที... (หรือกดปุ่มใดๆ เพื่อปิดทันที)
timeout /t 3 >nul 2>&1
